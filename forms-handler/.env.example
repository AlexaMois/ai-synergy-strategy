# Переменные обработчика форм. На сервере файл лежит в /opt/forms/.env
# с правами 600 и владельцем forms. В репозиторий значения не попадают.

# ── Bpium: куда пишется заявка ────────────────────────────────────────────
BPIUM_BASE_URL=https://neiroresheniyasandra.bpium.ru
BPIUM_LOGIN=
BPIUM_PASSWORD=
BPIUM_CATALOG_ID=81

# ── Уведомление НейроСекретарю ────────────────────────────────────────────
# Контракт менять нельзя: recordId, formName, pageUrl, createdAt.
NEUROSECRETARY_NOTIFY_URL=https://bot.atslogistik.ru/vasya/internal/site-lead
# Должно совпадать с SITE_LEAD_NOTIFY_SECRET на сервере бота.
NEUROSECRETARY_NOTIFY_SECRET=

# ── Хранилище фото анкеты нейростилиста (S3-совместимое, Timeweb) ─────────
# Пусто — маршрут /upload-url отвечает понятной ошибкой, остальные формы работают.
UPLOADS_BUCKET=
STORAGE_ENDPOINT=https://s3.timeweb.cloud
STORAGE_REGION=ru-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ── Служба ────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8090
# Каталог состояния очереди повторов. Создаётся systemd (StateDirectory).
STATE_DIR=/var/lib/forms-handler
MAX_BODY_BYTES=65536
ALLOWED_ORIGINS=https://aleksamois.ru,https://www.aleksamois.ru
