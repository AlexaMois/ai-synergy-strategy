# Переменные сборки фронтенда. Значения НЕ хранятся в репозитории:
# локально в .env (он в .gitignore), в деплое — в переменных GitHub Actions.

# Supabase: клиентский портал, админка, авторизация и MCP.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Обработчик форм сайта. Без этого значения формы не отправляются:
# данные никуда не уходят, пользователь видит понятную ошибку.
VITE_FORMS_BASE_URL=https://forms.aleksamois.ru
